# Caddy reverse proxy + free ACME TLS for the 1 GB box.
#   sudo apt install caddy   (static binary ~15 MB, lighter than nginx)
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
# Caddy terminates HTTPS at 127.0.0.1:8000 (uvicorn stays plain HTTP locally)
# and overwrites X-Forwarded-For with the real peer, which is all the app's
# rate limiter needs.
# Keep SITE_URL in .run/env (seeded from deploy/env.example) pointing at the
# same origin, or /sitemap.xml 404s and the story pages' og:image stays
# relative. A certificate is fetched on the first request; put a contact email
# that is really yours in the tls line.

feimatrix.com {
  tls your-name@feimatrix.com
  hsts {
    seconds 31622400
    direct
  }
  # Overwrite X-Forwarded-For with the real peer: Caddy's default is to append,
  # which lets a client spoof the first hop and dodge (or poison) the app's
  # per-IP rate limiter.
  reverse_proxy 127.0.0.1:8000 {
    header_up X-Forwarded-For {remote_host}
  }
}
